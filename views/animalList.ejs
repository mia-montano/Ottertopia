<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <!-- loop through the quotes and print them out -->
    <h1>Animal List</h1>
    <% for (let animal of animals) { %>
        <p><%= animal.name %></p>
    <% } %>
</body>
</html>